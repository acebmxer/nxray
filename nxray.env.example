# NXray configuration.
#
# Copy this file to nxray.env next to docker-compose.yml and fill it in:
#
#     cp nxray.env.example nxray.env
#
# nxray.env is gitignored and must never be committed. It is not called .env
# on purpose; see the comment in docker-compose.yml.example.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The first NXray account, an admin, is made from these two lines on the very
# first start. After that they are not read again: add accounts on the Users
# page, and change passwords on the Account or Users page (or with
# python -m app.resetpw, see docs/installation.md).
#
# The username of that first account.
NXRAY_ADMIN_USER=admin

# Argon2id hash of its password. NXray refuses to start without it and
# never falls back to a default password.
#
# Generate one with:
#     docker compose run --rm nxray python -m app.hashpw
#
# Paste the printed value here. It begins with $argon2id$; keep it on one line.
NXRAY_ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Signs session cookies. Leave blank and one is generated on first start and
# stored at /data/secret_key, so sessions survive a restart. It also encrypts
# the stored switch login and the two-factor keys. Changing it logs everyone
# out, means the switch has to be set up again on the Switch page, and
# accounts with two-factor sign-in need a backup code or an admin to turn it
# off for them.
#NXRAY_SECRET_KEY=

# Built-in HTTPS, no reverse proxy of your own needed. Off by default: NXray
# then serves plain HTTP on port 8080 as before. When true, NXray makes a
# self-signed certificate on its first start (upload your own on the Settings
# page), answers HTTPS on port 8443 and sends plain-HTTP visits there. The
# 8443:8443 line must be in the ports of docker-compose.yml. NXRAY_HTTPS
# below is then on by itself.
NXRAY_ENABLE_HTTPS=false

# The port browsers use for HTTPS: the left number of the 8443 line in
# docker-compose.yml. Only needed if you changed that number.
#NXRAY_HTTPS_PORT=8443

# Self-update. Off by default: NXray never contacts ghcr.io or Docker. When
# true, NXray checks ghcr.io once a day for a newer image and an admin can
# press "Update now" on the Settings page. Needs the docker.sock and group_add
# lines in docker-compose.yml uncommented. The Docker socket is root on the
# host machine; read the self-update note in docs/installation.md first.
NXRAY_ENABLE_SELF_UPDATE=true

# History. NXray reads the switch every this many seconds (10 to 3600) and
# draws temperatures, power, fans, CPU, memory and port traffic and errors on
# the History page and on each port's page. 30 days are kept. 0 turns history
# off. The default is a minute.
#NXRAY_HISTORY_INTERVAL=60

# NXRAY_DEV_BUILD is set by docker-compose.dev.yml for an image built from a
# clone, so it is never reported out of date. Do not set it here.

# Set to true when NXray is served over HTTPS by a reverse proxy of your own
# (not the built-in HTTPS above). Adds the Secure flag to the session cookie.
# Leave false for plain http, or the browser discards the cookie and signing
# in appears to fail.
NXRAY_HTTPS=false

# How long a session lasts, in hours (1-720). The clock slides forward on use.
NXRAY_SESSION_HOURS=12

# Login throttling: this many failures from one address inside the window
# blocks further attempts until the window passes.
NXRAY_LOGIN_MAX_ATTEMPTS=5
NXRAY_LOGIN_LOCKOUT_MINUTES=15

# Where the database, session key and certificate live inside the container. Change the
# volume in docker-compose.yml rather than this, normally.
NXRAY_DATA_DIR=/data

# DEBUG, INFO, WARNING or ERROR.
NXRAY_LOG_LEVEL=INFO
