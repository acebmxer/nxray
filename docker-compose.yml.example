services:
  nxray:
    # Published to GHCR by .github/workflows/release.yml, so this file plus
    # nxray.env is a complete deployment: no clone and no local build.
    #
    # Working from a clone instead? docker-compose.dev.yml builds the source
    # beside you, and is used alongside this file:
    #
    #   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build
    #
    # :latest tracks every release, so "docker compose pull" moves you onto a
    # new version. Pin one instead to stay put until you choose to move:
    #
    #   image: ghcr.io/acebmxer/nxray:0.1.0
    #
    image: ghcr.io/acebmxer/nxray:latest
    container_name: nxray
    restart: unless-stopped
    env_file:
      # Deliberately NOT named .env, and deliberately long-form.
      #
      # An Argon2 hash is full of $ ($argon2id$v=19$m=65536,...). Compose treats
      # $ as variable interpolation in two separate places, and both have to be
      # dealt with or the container receives a mangled hash and refuses to start:
      #
      #   1. Values loaded from env_file      -> fixed by "format: raw"
      #   2. Compose auto-loads ./.env as its OWN variable source for
      #      interpolating this file, whatever env_file says -> fixed by not
      #      calling the file .env
      - path: nxray.env
        required: true
        format: raw
    ports:
      # Reachable from other machines on your network on port 8080. Change
      # the left number to move it; the right one is the port inside the
      # container and never changes.
      #
      # This is plain HTTP: your NXray password and session travel
      # unencrypted. Turn on built-in HTTPS (NXRAY_ENABLE_HTTPS=true in
      # nxray.env, and the 8443 line below), or put NXray behind an HTTPS
      # reverse proxy of your own (and set NXRAY_HTTPS=true). With built-in
      # HTTPS on, this port only redirects to HTTPS.
      # To allow only the Docker host itself (a reverse proxy on the same
      # machine), put the loopback address in front:
      #
      #   - "127.0.0.1:8080:8080"
      #
      - "8080:8080"
      # HTTPS, answered only with NXRAY_ENABLE_HTTPS=true; nothing listens
      # here otherwise. If you change the left number, set NXRAY_HTTPS_PORT
      # in nxray.env to the same, so plain-HTTP visits are sent to the right
      # port.
      - "8443:8443"
    volumes:
      # Holds the SQLite database, the session signing key and, with
      # built-in HTTPS on, its certificate.
      - nxray-data:/data

volumes:
  nxray-data:
